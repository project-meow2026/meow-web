# ==========================================
# MEOW FOOTWEAR - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Supabase PostgreSQL & Auth Credentials
# Obtain from: https://app.supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is used exclusively server-side for administrative tasks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Cloudinary Media Storage (Images & Videos)
# Obtain from: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# 3. Application Domain & URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4. WhatsApp Business Concierge
# Format: Country code without '+' or special characters, e.g. 919876543210
NEXT_PUBLIC_BUSINESS_WHATSAPP_NUMBER=919876543210

# 5. Admin Authentication Secret / Token (optional for custom session protection)
ADMIN_SECRET_KEY=meow_luxury_footwear_admin_secret_token_2026
